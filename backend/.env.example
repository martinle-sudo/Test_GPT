# ============================================================
#  Configuration Lustre Backend — COPIE ce fichier vers .env
#  et remplis les vraies valeurs. Ne JAMAIS commiter .env.
# ============================================================

NODE_ENV=development
PORT=4000

# --- Base de données ---------------------------------------
# URL applicative : utilise le rôle "lustre_app" (NON super-utilisateur,
# soumis à la Row Level Security). C'est par CE rôle que passent toutes
# les requêtes des utilisateurs.
DATABASE_URL=postgres://lustre_app:lustre_app_dev_pw@localhost:5432/lustre_dev

# URL administrateur : sert UNIQUEMENT aux migrations (création des tables,
# rôles et politiques de sécurité). Utilise un compte privilégié.
DATABASE_ADMIN_URL=postgres://postgres:devpassword@localhost:5432/lustre_dev

# --- Sessions / cookies ------------------------------------
SESSION_COOKIE_NAME=lustre_sid
SESSION_TTL_HOURS=168
# Mettre true en production (cookies envoyés seulement en HTTPS)
COOKIE_SECURE=false

# Origine autorisée du frontend (pour CORS)
CORS_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# --- Stripe ------------------------------------------------
# Clé SECRÈTE : reste sur le serveur, JAMAIS dans le navigateur.
STRIPE_SECRET_KEY=sk_test_xxx
# Secret de signature des webhooks (fourni par Stripe lors de la config du endpoint).
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Identifiant du prix d'abonnement (créé dans le dashboard Stripe).
STRIPE_PRICE_ID=price_xxx
